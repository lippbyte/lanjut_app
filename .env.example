# ==============================================================================
# LANJUT App (Expo / Klien) — Contoh Variabel Lingkungan Lokal
# Salin ke .env bila ingin menyetel lokal (JANGAN commit .env).
# Semua saklar fitur v2 dan fitur uji MATI BAWAAN (0).
# Setiap kali mengubah variabel EXPO_PUBLIC_*, jalankan Expo dengan --clear.
# ==============================================================================

# Alamat API server lokal (dev)
EXPO_PUBLIC_API_URL=http://127.0.0.1:4000

# Saklar fitur v1/v2 (semua mati bawaan)
EXPO_PUBLIC_KELOLA_DATA_AKUN=0
EXPO_PUBLIC_PORTOFOLIO=0
EXPO_PUBLIC_JALUR_TUJUAN=0
EXPO_PUBLIC_DISCOVER=0
EXPO_PUBLIC_MIKROFON_NGOBROL=0

# Saklar antarmuka v2 (semua mati bawaan)
EXPO_PUBLIC_ALUR_MASUK_V2=0
EXPO_PUBLIC_NAVIGASI_V2=0
EXPO_PUBLIC_MODE_GELAP=0

# Alat belajar v1 di dalam antarmuka v2 (LANJUT_040).
# Bawaan: 0 (mati) — 10 rute Alat belajar v1 dan rute anaknya disembunyikan di v2
# (membuka langsung mengalihkan ke /arah-saya). Tidak berpengaruh saat NAVIGASI_V2=0.
EXPO_PUBLIC_ALAT_BELAJAR=0

# Khusus pengembangan lokal (diblokir Metro di luar dev)
EXPO_PUBLIC_GALERI_KOMPONEN=0
